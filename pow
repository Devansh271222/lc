class Solution {
public:
    double myPow(double x, int n) {
        if (n==0) return 1.0;
        if (x==0) return 0.0;
        if (n==1) return x;
        long long exp = n;
        double ans = 1;
        if (exp<0){
            x = 1/x;
            exp=-exp;
        }while(exp>0){
            if (exp%2==1){
                ans = ans*x;
            }
            x = x*x;
            exp = exp/2;
        }
        return ans;
    }
};
