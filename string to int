class Solution {
public:
    int myAtoi(string s) {
        int n = s.length();
        if(n==0){
            return 0;
        }
        int i=0;
        while(i<n && s[i]==' '){
            i++;
        }
        int sign = 1;
        long ans = 0;
        if(s[i] == '-' || s[i]=='+'){
            if(s[i]=='-')sign=-1;
            i++;
        }
        
        while(i<n && isdigit(s[i])){
            ans=ans*10+(s[i]-'0');
            if(sign == -1 && -1*ans<INT_MIN){
                return INT_MIN;
            }
            if(sign==1 && ans>INT_MAX){
                return INT_MAX;
            }
            i++;
        }
        return (int)(sign*ans);
    }
};
